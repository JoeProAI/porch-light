# Porch Light local secrets — copy to a gitignored .env. Never commit real values.
# Source of truth for names: HackOS Participant Setup Guide (21 Oct 2026) + engines/*.py

# --- DATA: Zetaris (local Docker; required) ---
# Zetaris itself keeps admin creds in ~/zetaris-platform/.env (or %USERPROFILE%\zetaris-platform\.env).
# Porch Light reads that file by default; override only if yours lives elsewhere.
PORCHLIGHT_ZETARIS_ENV_FILE=
PORCHLIGHT_ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
PORCHLIGHT_ZETARIS_JDBC_JAR=
PORCHLIGHT_ZETARIS_DATASOURCE=porchlight_postgis
PORCHLIGHT_ZETARIS_BUNDLE_VIEW=porchlight_manatee_bundle_v1
# Optional REST (UI on :3000, API on :8888/api/v1.0 — not :8889)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# --- POWER: Meterless Nightshift (required model path) ---
# Runtime token lives at %LOCALAPPDATA%\ai.meterless.runtime\proxy-token on Windows.
# Do NOT put the Meterless token or NVIDIA key into Cursor model-provider settings.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/deep
# App identity headers used by engines/grounded_drafts.py
# meterless-app: porch-light
# meterless-scope: user
# meterless-tier-split: off

# --- NVIDIA Nemotron (via Nightshift Providers tab, not app .env for the key) ---
# Paste NVIDIA key only in Nightshift Setup > Providers > NVIDIA.
# Required lane for award evidence (setup guide):
#   Lane fast: nvidia/nemotron-3.5-lightning-30b-a3b
#   Lane deep: nvidia/nemotron-3.5-super-vl-120b-a12b
# Porch Light currently evidences Super VL via meterless/deep receipts only.
NVIDIA_API_KEY=

# --- App modes ---
SAMPLE_MODE=true
PORCHLIGHT_DATA_ACCESS_MODE=zetaris_chain
