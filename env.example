# Porch Light local placeholders. Copy to a gitignored .env. Never commit real values.
# Lines marked READ are names this repository actually reads.
# Other lines are HackOS Participant Setup Guide notes (21 Oct 2026). They are not application switches.

# --- DATA: Zetaris (local Docker) ---
# Zetaris keeps admin credentials in ~/zetaris-platform/.env
# (or %USERPROFILE%\zetaris-platform\.env).
# READ: Porch Light uses that file by default. Set this only to point somewhere else.
PORCHLIGHT_ZETARIS_ENV_FILE=
# READ by engines/rank_manatee.py when set. The default JDBC URL is the same value.
PORCHLIGHT_ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# READ when the licensed jar is not on the default install path.
PORCHLIGHT_ZETARIS_JDBC_JAR=
# READ by engines/data_access.py. Defaults shown.
PORCHLIGHT_ZETARIS_DATASOURCE=porchlight_postgis
PORCHLIGHT_ZETARIS_BUNDLE_VIEW=porchlight_manatee_bundle_v1
# Setup-guide REST (UI on :3000, API on :8888/api/v1.0, not :8889).
# The application does not read ZETARIS_REST_URL, ZETARIS_ORG_ID, or ZETARIS_API_KEY.

# --- POWER: Meterless Nightshift + NVIDIA Nemotron (only runtime model path) ---
# The application does not read METERLESS_BASE_URL, METERLESS_RUNTIME_TOKEN,
# METERLESS_MODEL, or NVIDIA_API_KEY.
# engines/runtime_config.py sets BASE_URL http://127.0.0.1:8088/v1 and MODEL meterless/deep.
# Windows token file: %LOCALAPPDATA%\ai.meterless.runtime\proxy-token
# Put the NVIDIA key only in Nightshift Setup > Providers > NVIDIA.
# Do not put the Meterless token or NVIDIA key into Cursor model-provider settings.
# engines/grounded_drafts.py sends meterless-app: porch-light, meterless-scope: user,
# meterless-tier-split: off.
# Both ids are on meterless/deep in retained receipts:
#   nvidia/nemotron-3.5-super-vl-120b-a12b
#   nvidia/nemotron-3.5-lightning-30b-a3b
# Published county executions and the Scout Intent live receipt are the evidence.
# Local GPU / meterless/local is not claimed.
# Scout Intent gates live call scripts before that Meterless call. See engines/scout_intent.py.

# --- Ranker data-access mode (READ by engines/rank_manatee.py) ---
# Choices: zetaris (code default), zetaris_chain, postgis_development.
# National job snapshots report data_access_mode zetaris.
# There is no SAMPLE_MODE switch. The committed Manatee sheet is a real-source snapshot.
PORCHLIGHT_DATA_ACCESS_MODE=zetaris

# --- Optional OpenRouter Nemotron backup (NOT primary; call_script only by default) ---
# READ by engines/openrouter_backup.py when PORCHLIGHT_OPENROUTER_BACKUP is enabled.
# Hard spend cap. OpenRouter is not a scoring sponsor. Primary path remains Meterless Nightshift.
OPENROUTER_API_KEY=
OPENROUTER_MAX_SPEND_USD=5
PORCHLIGHT_OPENROUTER_BACKUP=call_script
# OPENROUTER_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
