# Porch Light local secrets — copy to a gitignored .env.local. Never commit real values.

# POWER: Meterless Nightshift (primary)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=

# Optional OpenRouter Nemotron backup (NOT primary; call_script only by default)
OPENROUTER_API_KEY=
OPENROUTER_MAX_SPEND_USD=5
PORCHLIGHT_OPENROUTER_BACKUP=call_script
# OPENROUTER_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
