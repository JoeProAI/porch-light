{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Porch Light",
  "description": "Nationwide call sheets for dialysis centers and nursing homes. Open any Census county on the published Zetaris audit. Nemotron drafts the reason. The formula ranks.",
  "colors": {
    "primary": "#f2a93b",
    "light": "#ffb547",
    "dark": "#05070b"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#f3eee3",
      "dark": "#05070b"
    }
  },
  "logo": {
    "light": "/logo/logo-light.svg",
    "dark": "/logo/logo-dark.svg",
    "href": "/"
  },
  "favicon": "/logo/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Libre Baskerville",
      "weight": 700
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/JoeProAI/porch-light"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Live desk",
      "href": "https://porchlight.earth/nationwide"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/JoeProAI/porch-light"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "nationwide",
          "manatee-walkthrough",
          "local-run",
          "limits"
        ]
      },
      {
        "group": "Product",
        "pages": [
          "architecture",
          "ranking",
          "evidence-trail",
          "eoc-snapshot-mode"
        ]
      },
      {
        "group": "Data",
        "pages": [
          "data-sources",
          "zetaris-federation",
          "country-adapters"
        ]
      },
      {
        "group": "Models",
        "pages": [
          "meterless-and-nemotron",
          "eval"
        ]
      },
      {
        "group": "Trust",
        "pages": [
          "privacy",
          "license"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "deploy"
        ]
      },
      {
        "group": "Sponsors",
        "pages": [
          "sponsors"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/introduction"
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  }
}
